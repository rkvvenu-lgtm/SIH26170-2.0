{
    "project": {
        "name": "AI-Assisted Adaptive Component Screening Platform",
        "version": "2.0"
    },

    "default_domain": "electronics",

    "data": {
        "component_id_column": "Component_ID",
        "lot_id_column": "Lot_ID",
        "component_type_column": "Component_Type",
        "temperature_column": "Temperature_C",

        "required_columns": [
            "Component_ID",
            "Lot_ID",
            "Component_Type",
            "Temperature_C",
            "Iddq_0h_uA",
            "Iddq_24h_uA",
            "Iddq_96h_uA",
            "Iddq_168h_uA",
            "Leakage_0h_uA",
            "Leakage_24h_uA",
            "Leakage_96h_uA",
            "Leakage_168h_uA",
            "Delay_0h_ns",
            "Delay_24h_ns",
            "Delay_96h_ns",
            "Delay_168h_ns"
        ]
    },

    "anomaly_detection": {
        "features": [
            "Iddq_0h_uA",
            "Iddq_24h_uA",
            "Iddq_96h_uA",
            "Leakage_0h_uA",
            "Leakage_24h_uA",
            "Leakage_96h_uA",
            "Delay_0h_ns",
            "Delay_24h_ns",
            "Delay_96h_ns"
        ],
        "contamination": 0.15,
        "n_estimators": 200,
        "z_threshold": 3.0
    },

    "drift_prediction": {
        "prediction_horizon": "168h",
        "warning_threshold": 0.20,
        "reject_threshold": 0.40,
        "test_size": 0.20,
        "random_state": 42,

        "parameters": {
            "IDDQ": {
                "features": [
                    "Iddq_0h_uA",
                    "Iddq_24h_uA",
                    "Iddq_96h_uA"
                ],
                "target": "Iddq_168h_uA",
                "current": "Iddq_96h_uA"
            },

            "Leakage": {
                "features": [
                    "Leakage_0h_uA",
                    "Leakage_24h_uA",
                    "Leakage_96h_uA"
                ],
                "target": "Leakage_168h_uA",
                "current": "Leakage_96h_uA"
            },

            "Delay": {
                "features": [
                    "Delay_0h_ns",
                    "Delay_24h_ns",
                    "Delay_96h_ns"
                ],
                "target": "Delay_168h_ns",
                "current": "Delay_96h_ns"
            }
        }
    },

    "risk_fusion": {
        "anomaly_weight": 0.50,
        "drift_weight": 0.50,
        "investigate_threshold": 0.25,
        "reject_threshold": 0.70
    },

    "decision_levels": {
        "pass": "PASS",
        "investigate": "INVESTIGATE",
        "reject": "REJECT"
    }
}